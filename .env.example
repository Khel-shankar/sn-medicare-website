# Copy to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables

# Razorpay (existing)
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# Site URL (optional)
NEXT_PUBLIC_SITE_URL=https://snmedicare.in

# Supabase (required for order storage + admin OTP)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Admin session signing (use a long random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret

# Who can login (comma-separated). Defaults also include info@snmedicare.in + Satvik phone.
ADMIN_EMAILS=info@snmedicare.in
ADMIN_PHONES=917014949153

# Dashboard password (works even if SMS OTP is not set up)
ADMIN_PASSWORD=change-this-strong-password

# Email OTP via Resend (optional in dev — OTP prints in terminal / UI)
RESEND_API_KEY=
RESEND_FROM_EMAIL=S.N. Medicare <onboarding@resend.dev>

# SMS OTP via MSG91 (optional in dev — OTP prints in terminal / UI)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SNMEDI

# Force show OTP in API response even in production (never leave on for live)
# ADMIN_OTP_DEBUG=true
